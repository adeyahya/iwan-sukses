# Salin ke .env.local lalu isi.

# Kata sandi untuk masuk ke /admin
ADMIN_PASSWORD=

# Kunci tanda tangan cookie sesi admin, minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Database. Default: file SQLite lokal di data/iwan-sukses.db.
# Di server dengan disk permanen: file:/path/ke/iwan-sukses.db
# Di Vercel/serverless: pakai libSQL/Turso, mis. libsql://nama-db.turso.io + DATABASE_AUTH_TOKEN
# DATABASE_URL=file:data/iwan-sukses.db
# DATABASE_AUTH_TOKEN=

# Salin ke .env.local lalu isi.

# Kunci rahasia login admin (better-auth), minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Alamat publik situs untuk login (dibaca saat server jalan). Kosong = NEXT_PUBLIC_SITE_URL / http://localhost:3000.
# BETTER_AUTH_URL=https://iwansukses.com

# Login admin dengan Google. Buat OAuth client (Web application) di
# https://console.cloud.google.com/apis/credentials lalu daftarkan Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google  (pengembangan)
#   https://<domain>/api/auth/callback/google        (produksi, = BETTER_AUTH_URL + /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database. Default: file SQLite lokal di data/iwan-sukses.db.
# Di server dengan disk permanen: file:/path/ke/iwan-sukses.db
# Di Vercel/serverless: pakai libSQL/Turso, mis. libsql://nama-db.turso.io + DATABASE_AUTH_TOKEN
# DATABASE_URL=file:data/iwan-sukses.db
# DATABASE_AUTH_TOKEN=

# Domain final situs (canonical, og:image, sitemap). Di Docker dipakai saat build.
# NEXT_PUBLIC_SITE_URL=https://iwansukses.com
